# URL base da Planix API (Spring Boot). SOMENTE PARA DESENVOLVIMENTO.
#
# Em producao esta variavel e ignorada: o build usa VITE_API_URL="" (fixo no
# compose.yaml) e o nginx faz proxy de /api para o backend, entao o front usa
# URLs relativas na mesma origem (http://localhost:5173) e nao ha CORS.
#
# Em dev o Vite serve os arquivos e o navegador chama o backend direto, logo:
#   - 8081 e a porta do backend do stack de dev (planix/compose.dev.yaml)
#   - o backend precisa liberar CORS para http://localhost:5174, a origem do
#     Vite em dev (planix.cors.allowed-origins no application.properties)
VITE_API_URL=http://localhost:8081
